# Database
DATABASE_URL=postgresql://fsp_user:fsp_secret@localhost:5432/food_security

# Redis
REDIS_URL=redis://localhost:6379
DISABLE_REDIS=false

# Server
PORT=3000
NODE_ENV=development

# BMKG Open Data API (https://data.bmkg.go.id)
# Forecast: https://data.bmkg.go.id/prakiraan-cuaca/
# Alerts: https://data.bmkg.go.id/peringatan-dini-cuaca/
BMKG_API_KEY=
BMKG_API_URL=https://data.bmkg.go.id/DataMKG/MEWS/DigitalForecast
BMKG_FORECAST_API_URL=https://api.bmkg.go.id/publik/prakiraan-cuaca
BMKG_ALERTS_RSS_URL=https://www.bmkg.go.id/alerts/nowcast/id
BMKG_REGION_ADM4_CODES={"JW":["31.71.03.1001"],"SM":["12.71.01.1001"],"KL":["64.72.01.1001"],"SL":["73.71.01.1001"],"NT":["52.71.01.1001"],"PM":["91.71.01.1001"]}

# BPS Web API (https://webapi.bps.go.id)
# Daftar di: https://webapi.bps.go.id/developer/
BPS_API_KEY=your_bps_api_key_here
BPS_API_URL=https://webapi.bps.go.id/v1/api

# BAPANAS / Panel Harga Pangan Nasional
PANELHARGA_URL=https://panelharga.badanpangan.go.id

# Bank Indonesia Harga Pangan
BI_HARGAPANGAN_URL=https://www.bi.go.id/hargapangan/WebSite/TabelHarga

# Google Maps Platform
# Server-side key for Google Routes API. Restrict it to Routes API and backend IP/service.
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_TIMEOUT_MS=7000

# Polling intervals (cron expressions)
WEATHER_POLL_INTERVAL=0 */6 * * *
PRICE_POLL_INTERVAL=0 6 * * *

# Cache TTL (seconds)
CACHE_TTL_WEATHER=21600
CACHE_TTL_PRICES=3600
CACHE_TTL_SUPPLY=1800

# Feature flags
USE_MOCK_DATA=true
USE_REAL_PRICE_DATA=false
USE_REAL_WEATHER_DATA=false
PRICE_LOOKBACK_DAYS=7

# Anthropic Claude API (untuk AI Forecasting)
# Daftar di: https://console.anthropic.com
# Tanpa API key, sistem menggunakan mock data yang realistis
ANTHROPIC_API_KEY=your_anthropic_api_key_here
